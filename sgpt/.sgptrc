CHAT_CACHE_PATH=/tmp/chat_cache
CACHE_PATH=/tmp/cache
CHAT_CACHE_LENGTH=100
CACHE_LENGTH=100
REQUEST_TIMEOUT=60
DEFAULT_MODEL=anthropic/claude-sonnet-5
DEFAULT_COLOR=magenta
DEFAULT_EXECUTE_SHELL_CMD=false
DISABLE_STREAMING=false
CODE_THEME=dracula
OPENAI_USE_FUNCTIONS=false
SHOW_FUNCTIONS_OUTPUT=false
API_BASE_URL=default
PRETTIFY_MARKDOWN=true
USE_LITELLM=true
SHELL_INTERACTION=true
OS_NAME=auto
SHELL_NAME=auto
# Despite the name, this MUST be the real Anthropic key: shell_gpt's
# handler.py passes this value straight through as litellm's `api_key` even
# when USE_LITELLM=true, which overrides litellm's normal ANTHROPIC_API_KEY
# env fallback. Set the real value via env var (~/.config/zsh/local.zsh),
# never here - this file is tracked in git.
# OPENAI_API_KEY=
